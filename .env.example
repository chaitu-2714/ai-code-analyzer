# --- Application -------------------------------------------------------
APP_NAME="AI Code Reviewer"
APP_VERSION="2.1.2"
DATABASE_URL="sqlite:///data/code_reviewer.db"
LOG_LEVEL="INFO"
LOG_FILE="logs/application.log"
DEBUG_MODE=True

# --- LLM provider (Phase 4) -------------------------------------------
# auto   -> use Gemini when GEMINI_API_KEY is set and reachable, else the
#           deterministic offline analyser (recommended)
# local  -> never use the network
# gemini -> Gemini only, still degrading to offline insights on failure
LLM_PROVIDER="auto"
# Leave empty to stay fully offline. Never commit a real key.
GEMINI_API_KEY=
# Placeholder values are ignored automatically.
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT=15
GEMINI_MAX_RETRIES=1

# --- Agents (Phase 5) --------------------------------------------------
AGENTS_ENABLED=true

# --- Static analysis (Phase 3) ----------------------------------------
MAX_FILE_SIZE_BYTES=1000000
MAX_FILES_PER_PROJECT=5000
COMPLEXITY_THRESHOLD=10
LONG_FUNCTION_THRESHOLD=50
DUPLICATE_WINDOW_LINES=6

# --- Fix verification (Phase 7) ---------------------------------------
VERIFY_TIMEOUT_SECONDS=120
